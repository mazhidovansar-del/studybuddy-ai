NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only secrets. Never use a NEXT_PUBLIC_ prefix for these.
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
